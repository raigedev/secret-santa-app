{
  "name": "secret-santa-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:e2e": "next start --hostname 127.0.0.1 --port 3000",
    "seed:e2e:local": "node ./scripts/repair-local-supabase-schema.mjs && node ./scripts/seed-local-playwright.mjs",
    "test:security": "node --test tests/security-remediation.test.mjs",
    "lint": "eslint app lib utils scripts tests *.ts *.mjs --no-error-on-unmatched-pattern",
    "lint:security": "eslint app lib utils scripts tests *.ts *.mjs --max-warnings=0 --no-error-on-unmatched-pattern",
    "check:problems": "node ./scripts/check-vscode-problems.mjs",
    "audit:architecture": "depcruise --config .dependency-cruiser.cjs --output-type err app lib scripts tests",
    "audit:security": "npm audit --audit-level=high",
    "audit:unused": "knip --reporter compact --no-exit-code",
    "audit:unused:production": "knip --production --reporter compact --no-exit-code",
    "analyze:bundle": "next experimental-analyze --output",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "prepare": "node ./scripts/prepare-husky.mjs",
    "import:lazada-feed": "powershell -ExecutionPolicy Bypass -File ./scripts/import-lazada-feed.ps1"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.3",
    "next": "16.2.12",
    "nodemailer": "^9.0.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^20.19.39",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^17.4.0",
    "@next/eslint-plugin-next": "16.2.12",
    "eslint": "^10.8.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.3.0",
    "knip": "^6.11.0",
    "postcss": "8.5.18",
    "supabase": "^2.98.1",
    "tailwindcss": "^4.2.4",
    "typescript-eslint": "^8.65.0",
    "typescript": "^5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "5.0.8"
    },
    "next": {
      "postcss": "8.5.18",
      "sharp": "0.35.3"
    }
  }
}
